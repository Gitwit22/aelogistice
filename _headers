# WEBHOOK CSP CONFIGURATION: add the exact HTTPS n8n origin after 'self' in
# connect-src below, e.g. https://YOUR-N8N-HOST. Never add a wildcard.
# Keep these origins in sync with FORM_ENDPOINTS in src/content.mjs (all three forms).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests
